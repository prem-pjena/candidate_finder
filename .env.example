# LM Studio / OpenAI-compatible API settings
# Default: LM Studio running on localhost:1234
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=not-needed
LLM_MODEL=local-model

# Server settings
HOST=0.0.0.0
PORT=8000

# Path to candidates dataset (relative to project root)
# Default: candidates.json in the project root
CANDIDATES_PATH=candidates.json
